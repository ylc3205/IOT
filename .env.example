# ==============================================================================
# SMART PARKING IOT - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env before starting services:
# cp .env.example .env
# ==============================================================================

# Node / Express Backend
NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# PostgreSQL Database (Local Docker Compose or external instance)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_pass
POSTGRES_DB=smart_parking_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres_secure_pass@localhost:5432/smart_parking_db?schema=public

# Eclipse Mosquitto MQTT Broker
MOSQUITTO_PORT=1883
MOSQUITTO_WS_PORT=9001
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_CLIENT_ID=smart-parking-backend-dev
MQTT_USERNAME=smartparking_user
MQTT_PASSWORD=smartparking_secret

# Security & Authentication
JWT_SECRET=dev_jwt_secret_change_in_production_min32chars
JWT_EXPIRES_IN=24h
SEED_ADMIN_PASSWORD=Admin@123456

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:5000/api
VITE_WS_BASE_URL=http://localhost:5000

